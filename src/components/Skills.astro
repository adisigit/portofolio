---
import SectionHeading from "./SectionHeading.astro";
import { skillCategories, certification, skillIcons } from "../data/skills";
---

<section id="skills" class="mx-auto max-w-5xl px-6 py-24">
    <SectionHeading eyebrow="What I work with" title="Skills" />
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        <div
            class="glass-card flex flex-col items-center justify-center gap-3 rounded-xl p-6"
        >
            <img
                id="skill-spotlight-image"
                src=""
                alt=""
                class="h-14 w-14 object-contain opacity-0 transition-opacity duration-300"
            />
            <div
                id="skill-spotlight-fallback"
                class="flex h-8 min-w-14 items-center justify-center whitespace-nowrap rounded-full border border-border bg-bg-elevated px-4 font-mono text-xs text-text-primary opacity-0 transition-opacity duration-300"
            >
            </div>
            <span
                id="skill-spotlight-name"
                class="font-mono text-xs text-text-primary"></span>
            <span
                id="skill-spotlight-category"
                class="font-mono text-[10px] uppercase tracking-widest text-accent-cyan"
            ></span>
        </div>
        {
            skillCategories.map((category, categoryIndex) => (
                <div
                    class="glass-card rounded-xl p-6"
                    data-skill-card
                    data-category-index={categoryIndex}
                >
                    <p class="mb-4 font-mono text-xs uppercase tracking-widest text-accent-cyan">
                        {category.name}
                    </p>
                    <div class="flex flex-wrap gap-2">
                        {category.items.map((item, itemIndex) => (
                            <span
                                class="skill-pill rounded-full border border-border bg-bg-elevated px-3 py-1 font-mono text-xs text-text-primary transition-colors duration-300"
                                data-item-index={itemIndex}
                            >
                                {item}
                            </span>
                        ))}
                    </div>
                    <div class="mt-4 h-1 w-full overflow-hidden rounded-full bg-bg-elevated">
                        <div class="skill-progress h-full w-0 bg-accent-cyan" />
                    </div>
                </div>
            ))
        }
    </div>
    <div
        class="glass-card mt-6 flex flex-wrap items-center justify-between gap-4 rounded-xl p-6"
    >
        <div>
            <p class="font-semibold text-text-primary">{certification.title}</p>
            <p class="text-sm text-text-muted">
                {certification.issuer} &middot; {certification.location}
            </p>
        </div>
        <span class="font-mono text-xs text-accent-cyan"
            >{certification.period}</span
        >
    </div>
</section>

<script define:vars={{ skillIcons }}>
    function initSkillSpotlight() {
        const cards = Array.from(
            document.querySelectorAll("[data-skill-card]"),
        );
        const image = document.getElementById("skill-spotlight-image");
        const fallback = document.getElementById("skill-spotlight-fallback");
        const nameLabel = document.getElementById("skill-spotlight-name");
        const categoryLabel = document.getElementById(
            "skill-spotlight-category",
        );

        if (
            !cards.length ||
            !image ||
            !fallback ||
            !nameLabel ||
            !categoryLabel
        )
            return;

        const ITEM_DURATION = 1200;

        let activeCard = 0;
        let activeItem = 0;

        function clearActivePills(card) {
            card.querySelectorAll(".skill-pill").forEach((pill) => {
                pill.classList.remove(
                    "bg-accent-cyan",
                    "text-bg-base",
                    "border-accent-cyan",
                );
            });
        }

        function resetProgress(card) {
            const bar = card.querySelector(".skill-progress");
            if (bar) {
                bar.style.transition = "none";
                bar.style.width = "0%";
            }
        }

        function showSkill(card, itemIndex, categoryName, totalItems) {
            const pills = card.querySelectorAll(".skill-pill");
            clearActivePills(card);
            const pill = pills[itemIndex];
            if (pill)
                pill.classList.add(
                    "bg-accent-cyan",
                    "text-bg-base",
                    "border-accent-cyan",
                );

            const skillName = pill ? pill.textContent.trim() : "";
            const iconUrl = skillIcons[skillName];

            if (iconUrl) {
                image.src = iconUrl;
                image.alt = skillName;
                image.style.opacity = "1";
                fallback.style.opacity = "0";
            } else {
                image.style.opacity = "0";
                fallback.textContent = skillName;
                fallback.style.opacity = "1";
            }

            nameLabel.textContent = skillName;
            categoryLabel.textContent = categoryName;

            const bar = card.querySelector(".skill-progress");
            if (bar) {
                const targetPercent = ((itemIndex + 1) / totalItems) * 100;
                bar.style.transition = `width ${ITEM_DURATION}ms linear`;
                bar.style.width = `${targetPercent}%`;
            }
        }

        function tick() {
            const card = cards[activeCard];
            const categoryName =
                card.querySelector("p")?.textContent?.trim() ?? "";
            const totalItems = card.querySelectorAll(".skill-pill").length;

            showSkill(card, activeItem, categoryName, totalItems);

            setTimeout(() => {
                activeItem++;
                if (activeItem >= totalItems) {
                    clearActivePills(card);
                    resetProgress(card);
                    activeItem = 0;
                    activeCard = (activeCard + 1) % cards.length;
                }
                tick();
            }, ITEM_DURATION);
        }

        tick();
    }

    document.addEventListener("astro:page-load", initSkillSpotlight);
    initSkillSpotlight();
</script>
