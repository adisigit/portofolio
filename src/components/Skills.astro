---
import SectionHeading from "./SectionHeading.astro";
import { skillCategories, certification, skillIcons } from "../data/skills";

const accents = [
    {
        hex: "#7a3dff",
        chipActive: "bg-accent-purple text-white border-accent-purple",
        barFill: "bg-accent-purple",
    },
    {
        hex: "#ed52cb",
        chipActive: "bg-accent-pink text-white border-accent-pink",
        barFill: "bg-accent-pink",
    },
    {
        hex: "#3b89ff",
        chipActive: "bg-accent-blue text-white border-accent-blue",
        barFill: "bg-accent-blue",
    },
    {
        hex: "#ff6b00",
        chipActive: "bg-accent-orange text-white border-accent-orange",
        barFill: "bg-accent-orange",
    },
    {
        hex: "#00d722",
        chipActive: "bg-accent-green text-ink border-accent-green",
        barFill: "bg-accent-green",
    },
];
---

<section
    id="skills"
    class="mx-auto max-w-5xl border-t border-hairline px-6 py-24 sm:px-8"
>
    <SectionHeading eyebrow="What I work with" title="Skills" />

    <div class="card mb-5 flex items-center gap-4 p-6">
        <img
            id="skill-spotlight-image"
            src=""
            alt=""
            class="h-10 w-10 shrink-0 object-contain opacity-0 transition-opacity duration-300"
        />
        <div
            id="skill-spotlight-fallback"
            class="flex h-10 min-w-14 shrink-0 items-center justify-center rounded border border-hairline px-3 font-mono text-xs text-ink opacity-0 transition-opacity duration-300"
        >
        </div>
        <span
            id="skill-spotlight-swatch"
            class="h-2.5 w-2.5 shrink-0 rounded-full"></span>
        <div class="min-w-0">
            <p id="skill-spotlight-name" class="truncate font-medium text-ink">
            </p>
            <p id="skill-spotlight-category" class="eyebrow-sm"></p>
        </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
            skillCategories.map((category, categoryIndex) => {
                const accent = accents[categoryIndex % accents.length];
                return (
                    <div
                        class="card p-6"
                        data-skill-card
                        data-category-index={categoryIndex}
                        data-color={accent.hex}
                        data-chip-active={accent.chipActive}
                        data-bar-fill={accent.barFill}
                    >
                        <p class="mb-4 flex items-center gap-2 text-xs font-medium uppercase tracking-[0.09375rem] text-body-mid">
                            <span
                                class="h-1.5 w-1.5 rounded-full"
                                style={`background-color:${accent.hex}`}
                            />
                            {category.name}
                        </p>
                        <div class="flex flex-wrap gap-2">
                            {category.items.map((item, itemIndex) => (
                                <span
                                    class="skill-pill rounded border border-hairline px-3 py-1 font-mono text-xs text-body-mid transition-colors duration-300"
                                    data-item-index={itemIndex}
                                >
                                    {item}
                                </span>
                            ))}
                        </div>
                        <div class="mt-4 h-1 w-full overflow-hidden rounded-full bg-hairline-soft">
                            <div
                                class={`skill-progress h-full w-0 ${accent.barFill}`}
                            />
                        </div>
                    </div>
                );
            })
        }
    </div>
    <div
        class="card mt-6 flex flex-wrap items-center justify-between gap-4 p-6"
    >
        <div>
            <p class="font-semibold text-ink">{certification.title}</p>
            <p class="text-sm text-body-mid">
                {certification.issuer} &middot; {certification.location}
            </p>
        </div>
        <span class="font-mono text-xs text-body-mid"
            >{certification.period}</span
        >
    </div>
</section>

<script define:vars={{ skillIcons }}>
    function initSkillSpotlight() {
        const cards = Array.from(
            document.querySelectorAll("[data-skill-card]"),
        );
        const image = document.getElementById("skill-spotlight-image");
        const fallback = document.getElementById("skill-spotlight-fallback");
        const swatch = document.getElementById("skill-spotlight-swatch");
        const nameLabel = document.getElementById("skill-spotlight-name");
        const categoryLabel = document.getElementById(
            "skill-spotlight-category",
        );

        if (
            !cards.length ||
            !image ||
            !fallback ||
            !swatch ||
            !nameLabel ||
            !categoryLabel
        )
            return;

        const ITEM_DURATION = 1200;

        let activeCard = 0;
        let activeItem = 0;

        function clearActivePills(card) {
            const activeClasses = (card.dataset.chipActive || "")
                .split(" ")
                .filter(Boolean);
            card.querySelectorAll(".skill-pill").forEach((pill) => {
                pill.classList.remove(...activeClasses);
                pill.classList.add("border-hairline");
            });
        }

        function resetProgress(card) {
            const bar = card.querySelector(".skill-progress");
            if (bar) {
                bar.style.transition = "none";
                bar.style.width = "0%";
            }
        }

        function showSkill(card, itemIndex, categoryName, totalItems) {
            const pills = card.querySelectorAll(".skill-pill");
            clearActivePills(card);
            const activeClasses = (card.dataset.chipActive || "")
                .split(" ")
                .filter(Boolean);
            const pill = pills[itemIndex];
            if (pill) {
                pill.classList.remove("border-hairline");
                pill.classList.add(...activeClasses);
            }

            const skillName = pill ? pill.textContent.trim() : "";
            const iconUrl = skillIcons[skillName];

            if (iconUrl) {
                image.src = iconUrl;
                image.alt = skillName;
                image.style.opacity = "1";
                fallback.style.opacity = "0";
            } else {
                image.style.opacity = "0";
                fallback.textContent = skillName;
                fallback.style.opacity = "1";
            }

            swatch.style.backgroundColor =
                card.dataset.color || "var(--color-ink)";
            nameLabel.textContent = skillName;
            categoryLabel.textContent = categoryName;

            const bar = card.querySelector(".skill-progress");
            if (bar) {
                const targetPercent = ((itemIndex + 1) / totalItems) * 100;
                bar.style.transition = `width ${ITEM_DURATION}ms linear`;
                bar.style.width = `${targetPercent}%`;
            }
        }

        function tick() {
            const card = cards[activeCard];
            const categoryName =
                card.querySelector("p")?.textContent?.trim() ?? "";
            const totalItems = card.querySelectorAll(".skill-pill").length;

            showSkill(card, activeItem, categoryName, totalItems);

            setTimeout(() => {
                activeItem++;
                if (activeItem >= totalItems) {
                    clearActivePills(card);
                    resetProgress(card);
                    activeItem = 0;
                    activeCard = (activeCard + 1) % cards.length;
                }
                tick();
            }, ITEM_DURATION);
        }

        tick();
    }

    document.addEventListener("astro:page-load", initSkillSpotlight);
    initSkillSpotlight();
</script>
