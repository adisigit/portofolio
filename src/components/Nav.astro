---
import { profile } from "../data/profile";

const links = [
    { href: "#about", label: "About" },
    { href: "#experience", label: "Experience" },
    { href: "#projects", label: "Projects" },
    { href: "#skills", label: "Skills" },
    { href: "#contact", label: "Contact" },
];
---

<header
    id="site-nav"
    class="fixed inset-x-0 top-0 z-50 border-b border-hairline bg-canvas/95 backdrop-blur-sm"
>
    <nav
        class="mx-auto flex max-w-5xl items-center justify-between px-6 py-4 sm:px-8"
    >
        <a href="/" class="font-mono text-sm font-medium text-ink">
            {profile.githubUsername}<span class="text-accent-blue">.</span>
        </a>

        <ul class="hidden items-center gap-8 md:flex">
            {
                links.map((link) => (
                    <li>
                        <a
                            href={link.href}
                            class="nav-link relative text-sm font-medium text-body-mid transition-colors hover:text-ink"
                            data-target={link.href}
                        >
                            {link.label}
                        </a>
                    </li>
                ))
            }
        </ul>

        <a
            href="#contact"
            class="btn btn-primary hidden text-sm md:inline-flex"
        >
            Get in touch
        </a>

        <button
            id="menu-toggle"
            aria-label="Toggle menu"
            aria-expanded="false"
            class="flex h-9 w-9 items-center justify-center rounded border border-hairline text-ink md:hidden"
        >
            <svg
                id="icon-open"
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg
                id="icon-close"
                xmlns="http://www.w3.org/2000/svg"
                class="hidden h-5 w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </nav>

    <ul
        id="mobile-menu"
        class="hidden flex-col gap-1 border-t border-hairline bg-canvas px-6 py-4 md:hidden"
    >
        {
            links.map((link) => (
                <li>
                    <a
                        href={link.href}
                        class="mobile-nav-link block rounded px-2 py-2 text-sm font-medium text-body-mid transition-colors hover:bg-canvas-soft hover:text-ink"
                    >
                        {link.label}
                    </a>
                </li>
            ))
        }
    </ul>
</header>

<style>
    .nav-link.is-active {
        color: var(--color-ink);
    }
    .nav-link::after {
        content: "";
        position: absolute;
        left: 0;
        bottom: -6px;
        width: 100%;
        height: 1px;
        background-color: var(--color-ink);
        transform: scaleX(0);
        transform-origin: left;
        transition: transform 200ms ease;
    }
    .nav-link.is-active::after {
        transform: scaleX(1);
    }
</style>

<script>
    const toggle = document.getElementById("menu-toggle");
    const menu = document.getElementById("mobile-menu");
    const iconOpen = document.getElementById("icon-open");
    const iconClose = document.getElementById("icon-close");

    toggle?.addEventListener("click", () => {
        const isOpen = menu?.classList.contains("flex");
        menu?.classList.toggle("hidden");
        menu?.classList.toggle("flex");
        iconOpen?.classList.toggle("hidden");
        iconClose?.classList.toggle("hidden");
        toggle.setAttribute("aria-expanded", String(!isOpen));
    });

    document.querySelectorAll(".mobile-nav-link").forEach((link) => {
        link.addEventListener("click", () => {
            menu?.classList.add("hidden");
            menu?.classList.remove("flex");
            iconOpen?.classList.remove("hidden");
            iconClose?.classList.add("hidden");
            toggle?.setAttribute("aria-expanded", "false");
        });
    });

    const sections = Array.from(document.querySelectorAll("section[id]"));
    const navLinks = document.querySelectorAll<HTMLAnchorElement>(".nav-link");

    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                if (entry.isIntersecting) {
                    const id = `#${entry.target.id}`;
                    navLinks.forEach((link) => {
                        link.classList.toggle(
                            "is-active",
                            link.dataset.target === id,
                        );
                    });
                }
            });
        },
        { rootMargin: "-40% 0px -50% 0px" },
    );

    sections.forEach((section) => observer.observe(section));
</script>
