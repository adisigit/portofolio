---
import SectionHeading from "./SectionHeading.astro";
import { profile } from "../data/profile";
import { education } from "../data/education";
---

<section
    id="about"
    class="mx-auto max-w-5xl border-t border-hairline px-6 py-24 sm:px-8"
>
    <SectionHeading eyebrow="Get to know" title="About me" />
    <div class="grid gap-8 md:grid-cols-5">
        <p class="text-balance text-lg leading-relaxed text-body md:col-span-3">
            {profile.bio}
        </p>
        <div class="card p-6 md:col-span-2">
            <p class="eyebrow-sm mb-4">Education</p>
            {
                education.map((edu) => (
                    <div>
                        <p class="font-medium text-ink">{edu.institution}</p>
                        <p class="mt-1 text-sm text-body-mid">{edu.degree}</p>
                        <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-mute">
                            <span>{edu.period}</span>
                            <span class="h-1 w-1 rounded-full bg-hairline" />
                            <span>{edu.location}</span>
                            {edu.gpa && (
                                <>
                                    <span class="h-1 w-1 rounded-full bg-hairline" />
                                    <span class="font-mono text-accent-blue-info">
                                        GPA {edu.gpa}
                                    </span>
                                </>
                            )}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
