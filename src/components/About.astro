---
import SectionHeading from "./SectionHeading.astro";
import { profile } from "../data/profile";
import { education } from "../data/education";
---

<section id="about" class="mx-auto max-w-5xl px-6 py-24">
    <SectionHeading eyebrow="Get to know" title="About Me" />

    <div class="grid gap-8 md:grid-cols-5">
        <p class="text-balance leading-relaxed text-text-muted md:col-span-3">
            {profile.bio}
        </p>

        <div class="glass-card rounded-xl p-6 md:col-span-2">
            <p
                class="mb-4 font-mono text-xs uppercase tracking-widest text-accent-cyan"
            >
                Education
            </p>
            {
                education.map((edu) => (
                    <div>
                        <p class="font-semibold text-text-primary">
                            {edu.institution}
                        </p>
                        <p class="mt-1 text-sm text-text-muted">{edu.degree}</p>
                        <div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-text-muted">
                            <span>{edu.period}</span>
                            <span class="h-1 w-1 rounded-full bg-text-muted" />
                            <span>{edu.location}</span>
                            {edu.gpa && (
                                <>
                                    <span class="h-1 w-1 rounded-full bg-text-muted" />
                                    <span class="font-mono text-accent-cyan">
                                        GPA {edu.gpa}
                                    </span>
                                </>
                            )}
                        </div>
                    </div>
                ))
            }
        </div>
    </div>
</section>
