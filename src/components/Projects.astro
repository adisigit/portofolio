---
import SectionHeading from "./SectionHeading.astro";
import { projects } from "../data/projects";
---

<section id="projects" class="mx-auto max-w-5xl px-6 py-24">
    <SectionHeading eyebrow="What I've built" title="Projects" />

    <div class="grid gap-6 sm:grid-cols-2">
        {
            projects.map((project) => (
                <div class="glass-card flex flex-col rounded-xl p-6 transition-transform hover:-translate-y-1">
                    <div class="mb-2 flex items-start justify-between gap-2">
                        <h3 class="font-semibold text-text-primary">
                            {project.title}
                        </h3>
                        <span class="whitespace-nowrap font-mono text-[11px] text-text-muted">
                            {project.period}
                        </span>
                    </div>

                    <ul class="mb-4 space-y-1.5">
                        {project.description.map((line) => (
                            <li class="text-sm leading-relaxed text-text-muted">
                                {line}
                            </li>
                        ))}
                    </ul>

                    <div class="mt-auto flex flex-wrap gap-2 pt-2">
                        {project.tech.map((t) => (
                            <span class="rounded-full border border-border bg-bg-elevated px-2.5 py-1 font-mono text-[11px] text-accent-cyan">
                                {t}
                            </span>
                        ))}
                    </div>

                    {(project.githubUrl || project.liveUrl) && (
                        <div class="mt-4 flex gap-4 border-t border-border pt-4 text-sm">
                            {project.githubUrl && (
                                <a
                                    href={project.githubUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-text-muted transition-colors hover:text-accent-cyan"
                                >
                                    GitHub →
                                </a>
                            )}
                            {project.liveUrl && (
                                <a
                                    href={project.liveUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-text-muted transition-colors hover:text-accent-cyan"
                                >
                                    Live →
                                </a>
                            )}
                        </div>
                    )}
                </div>
            ))
        }
    </div>
</section>
