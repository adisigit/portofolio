---
import SectionHeading from "./SectionHeading.astro";
import { projects } from "../data/projects";
---

<section
    id="projects"
    class="mx-auto max-w-5xl border-t border-hairline px-6 py-24 sm:px-8"
>
    <SectionHeading eyebrow="What I've built" title="Projects" />
    <div class="grid gap-6 sm:grid-cols-2">
        {
            projects.map((project) => (
                <div class="card group flex flex-col p-6 transition-shadow hover:shadow-layered">
                    <div class="mb-2 flex items-start justify-between gap-2">
                        <h3 class="font-semibold text-ink">{project.title}</h3>
                        <span class="whitespace-nowrap font-mono text-[11px] text-mute">
                            {project.period}
                        </span>
                    </div>
                    <ul class="mb-4 space-y-1.5">
                        {project.description.map((line) => (
                            <li class="text-sm leading-relaxed text-body-mid">
                                {line}
                            </li>
                        ))}
                    </ul>
                    <div class="mt-auto flex flex-wrap gap-2 pt-2">
                        {project.tech.map((t) => (
                            <span class="rounded border border-hairline px-2.5 py-1 font-mono text-[11px] text-body-mid">
                                {t}
                            </span>
                        ))}
                    </div>
                    {(project.githubUrl || project.liveUrl) && (
                        <div class="mt-4 flex gap-5 border-t border-hairline pt-4 text-sm font-medium">
                            {project.githubUrl && (
                                <a
                                    href={project.githubUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-ink transition-colors hover:text-accent-blue-deep"
                                >
                                    GitHub →
                                </a>
                            )}
                            {project.liveUrl && (
                                <a
                                    href={project.liveUrl}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="text-ink transition-colors hover:text-accent-blue-deep"
                                >
                                    Live →
                                </a>
                            )}
                        </div>
                    )}
                </div>
            ))
        }
    </div>
</section>
