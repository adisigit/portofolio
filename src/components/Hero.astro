---
import { profile } from "../data/profile";
import profileImg from "../assets/profile.jpeg";
import Image from "astro/components/Image.astro";
---

<section
    id="hero"
    class="relative flex min-h-screen items-center justify-center px-6 pt-24 sm:px-8"
>
    <div
        class="mx-auto grid max-w-5xl items-center gap-12 md:grid-cols-[minmax(0,300px)_1fr] md:gap-16"
    >
        <div class="mx-auto w-full max-w-55 md:max-w-none">
            <div
                class="card relative aspect-1026/1384 overflow-hidden shadow-layered"
            >
                <Image
                    src={profileImg}
                    alt={profile.name}
                    width="1026"
                    height="1384"
                    class="h-full w-full object-cover"
                    loading="eager"
                />
            </div>
        </div>
        <div class="text-center md:text-left">
            <p class="eyebrow mb-5">{profile.role}</p>
            <h1
                class="mb-6 text-[clamp(2.5rem,7vw,5rem)] font-semibold leading-[1.04] tracking-[-0.02em] text-ink"
            >
                {profile.name}
            </h1>
            <p
                class="mx-auto mb-10 max-w-xl text-balance text-lg leading-relaxed text-body-mid md:mx-0"
            >
                {profile.tagline}
            </p>
            <div
                class="flex flex-wrap items-center justify-center gap-4 md:justify-start"
            >
                <a href="#projects" class="btn btn-primary"> View projects </a>
                <a href="#contact" class="btn btn-secondary"> Contact </a>
            </div>
        </div>
    </div>
</section>
