<div class="bg-blobs" aria-hidden="true">
    <div class="blob blob-cyan"></div>
    <div class="blob blob-violet"></div>
    <div class="blob blob-cyan-soft"></div>
</div>

<style>
    .bg-blobs {
        position: fixed;
        inset: 0;
        overflow: hidden;
        z-index: 0;
        pointer-events: none;
    }

    .blob {
        position: absolute;
        border-radius: 50%;
        filter: blur(80px);
        will-change: transform;
    }

    .blob-cyan {
        width: 700px;
        height: 700px;
        top: -10%;
        left: 0%;
        background: rgba(6, 182, 212, 0.18);
        animation: float-a 22s ease-in-out infinite;
    }

    .blob-violet {
        width: 700px;
        height: 700px;
        top: 10%;
        right: -10%;
        background: rgba(139, 92, 246, 0.16);
        animation: float-b 26s ease-in-out infinite;
    }

    .blob-cyan-soft {
        width: 900px;
        height: 900px;
        bottom: -20%;
        left: 25%;
        background: rgba(6, 182, 212, 0.08);
        animation: float-c 30s ease-in-out infinite;
    }

    @keyframes float-a {
        0%,
        100% {
            transform: translate(0, 0) scale(1);
        }
        50% {
            transform: translate(60px, 80px) scale(1.1);
        }
    }

    @keyframes float-b {
        0%,
        100% {
            transform: translate(0, 0) scale(1);
        }
        50% {
            transform: translate(-70px, 60px) scale(0.95);
        }
    }

    @keyframes float-c {
        0%,
        100% {
            transform: translate(0, 0) scale(1);
        }
        50% {
            transform: translate(40px, -50px) scale(1.05);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .blob {
            animation: none;
        }
    }
</style>
