---
import { profile } from "../data/profile";
---

<section
    id="contact"
    class="mx-auto max-w-5xl border-t border-hairline px-6 py-24 sm:px-8"
>
    <div class="card flex flex-col items-start gap-6 p-10 sm:p-14">
        <p class="eyebrow">Let's talk</p>
        <h2
            class="max-w-xl text-3xl font-semibold leading-tight tracking-[-0.01em] text-ink sm:text-4xl"
        >
            Have a role, a project, or just a question? I'd like to hear from
            you.
        </h2>
        <p class="max-w-lg text-body-mid">
            The fastest way to reach me is email. I try to reply within a couple
            of days.
        </p>
        <div class="flex flex-wrap items-center gap-4">
            <a href={`mailto:${profile.email}`} class="btn btn-primary">
                {profile.email}
            </a>
            {
                profile.github && (
                    <a
                        href={profile.github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-secondary"
                    >
                        GitHub
                    </a>
                )
            }
            {
                profile.phone && (
                    <a
                        href={`tel:${profile.phone}`}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-secondary"
                    >
                        {profile.phone}
                    </a>
                )
            }
        </div>
    </div>
</section>
