---
interface Props {
    eyebrow: string;
    title: string;
}
const { eyebrow, title } = Astro.props;
---

<div class="mb-12 flex flex-col items-start gap-3">
    <span class="eyebrow">{eyebrow}</span>
    <div class="flex w-full items-center gap-6">
        <h2
            class="text-3xl font-semibold tracking-[-0.01em] text-ink sm:text-4xl"
        >
            {title}
        </h2>
        <span class="h-px flex-1 bg-hairline"></span>
    </div>
</div>
